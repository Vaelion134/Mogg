<Window x:Class="моггейм.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MO3GAME"
        Width="400"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#1A1A1A"
        FocusManager.FocusedElement="{Binding ElementName=LoginBox}">

    <Window.Resources>
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="0,9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="25">
        <TextBlock Text="MO3GAME"
                   Foreground="#C77DFF"
                   FontSize="28"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,18"/>

        <Border Background="#2D2D2D" CornerRadius="6" Padding="3" Margin="0,0,0,20">
            <UniformGrid Columns="2">
                <Button x:Name="LoginTab" Content="Вход" Style="{StaticResource TabButton}" Click="LoginTab_Click"/>
                <Button x:Name="RegisterTab" Content="Регистрация" Style="{StaticResource TabButton}" Click="RegisterTab_Click"/>
            </UniformGrid>
        </Border>

        <TextBlock Text="Логин" Foreground="White" Margin="0,0,0,5"/>
        <TextBox x:Name="LoginBox"
                 Height="35"
                 Padding="8"
                 FontSize="14"
                 Margin="0,0,0,12"
                 VerticalContentAlignment="Center"/>

        <TextBlock Text="Пароль" Foreground="White" Margin="0,0,0,5"/>
        <PasswordBox x:Name="PasswordBox"
                     Height="35"
                     Padding="8"
                     FontSize="14"
                     Margin="0,0,0,12"
                     VerticalContentAlignment="Center"/>

        <StackPanel x:Name="ConfirmPanel">
            <TextBlock Text="Повторите пароль" Foreground="White" Margin="0,0,0,5"/>
            <PasswordBox x:Name="ConfirmPasswordBox"
                         Height="35"
                         Padding="8"
                         FontSize="14"
                         Margin="0,0,0,12"
                         VerticalContentAlignment="Center"/>
        </StackPanel>

        <TextBlock x:Name="ErrorText"
                   Foreground="#FFFF6B6B"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"/>

        <Button x:Name="SubmitButton"
                Height="42"
                Background="#9D3EEE"
                Foreground="White"
                FontSize="14"
                FontWeight="Bold"
                BorderThickness="0"
                Cursor="Hand"
                IsDefault="True"
                Click="Submit_Click"/>
    </StackPanel>
</Window>
