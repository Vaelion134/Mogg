<Window x:Class="моггейм.CartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Корзина — MO3GAME"
        Width="450" Height="480" MinWidth="380" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Background="#1A1A1A">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Корзина" Foreground="#FFC7B7F5" FontSize="24" FontWeight="Bold" Margin="0,0,0,15"/>

        <ListBox x:Name="CartList" Grid.Row="1" Background="#2D2D2D" BorderThickness="0"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Title}" Foreground="White" FontSize="15"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Text="{Binding PriceText}" Foreground="#FFC7B7F5" FontSize="15"
                                   FontWeight="Bold" VerticalAlignment="Center" Margin="10,0"/>

                        <Border Grid.Column="2" Background="White" CornerRadius="4" BorderBrush="#FF9D3EEE" BorderThickness="1.5" Margin="2">
                            <Button Content="Удалить" Click="Remove_Click" Background="Transparent" BorderThickness="0" Foreground="Black"/>
                        </Border>

                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="EmptyText" Grid.Row="1" Text="Корзина пуста" Foreground="Gray" FontSize="16"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

        <Grid Grid.Row="2" Margin="0,15,0,0">
            <TextBlock x:Name="TotalText" Foreground="White" FontSize="18" FontWeight="Bold"
                       VerticalAlignment="Center"/>

            <Border Background="White"
        CornerRadius="9"
        BorderBrush="#FF9D3EEE"
        BorderThickness="2"
        HorizontalAlignment="Right"
        Height="38">
                <Button x:Name="OrderButton"
            Content="Оформить заказ"
            Padding="18,0"
            Background="Transparent"
            Foreground="Black"
            FontWeight="Bold"
            BorderThickness="0"
            Click="Order_Click"/>
            </Border>

        </Grid>
    </Grid>
</Window>
